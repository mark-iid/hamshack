cosign.key
cosign.private
/Containerfile
*.iso
*.iso-CHECKSUM
/.bluebuild-scripts_*

# Python bytecode (vm/serial-cmd.py). A tracked .pyc is both churn and a poor
# place to notice a change — bytecode does not review.
__pycache__/
*.pyc

# VM test artifacts (large disk images / exported archives / runtime junk)
/vm/output/
/vm/*.oci
/vm/*.pid
/vm/*.sock
*.oci
*.qcow2
*.tar
*.tar.gz

# Working-directory droppings from ham apps launched with the repo as CWD.
# TLF writes .paras/.bmdata.dat/tlfmarkers/<contest>.log on first run; the RT
# Systems updater writes UpdateLog.Txt under Wine. All of these got committed by
# accident once (86f678b, ea7c331) — they are per-run state, not configuration,
# and nothing in the image reads them.
.paras
.bmdata.dat
tlfmarkers
*.log
UpdateLog.Txt
