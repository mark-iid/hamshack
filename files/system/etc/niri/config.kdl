// kb3lyb-shack — baked niri default config.
//
// This lives at /etc/niri/config.kdl, niri's SYSTEM fallback. It is NOT in
// /etc/skel on purpose: skel copies into $HOME and would collide with the real
// config stow-deployed from the dotfiles repo (DESIGN §6). A system fallback
// gives a fresh user a working session while leaving $HOME empty for stow.
//
// Keep this minimal and "sane default". Real iteration happens in the dotfiles
// repo and takes effect on `niri msg action reload-config` (DESIGN §6 test).

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    // No touchpad block: this is a desktop. focus-follows-mouse is kept — with
    // several ham apps parked across two heads, reaching for one should not cost
    // a click that a decoder window might interpret.
    focus-follows-mouse
}

// DISPLAYS — real connector names, read off the machine 2026-08-26.
//
// These were placeholders (DP-1/DP-2) until the machine existed. The actual
// connectors are DP-3 and HDMI-A-1; the other four DP/HDMI connectors the i915
// exposes are disconnected. Confirm after any cable change with:
//
//     niri msg outputs
//
// HDMI-A-1 is the larger panel, is the one the operator faces, and sits at the
// origin. DP-3 is to its LEFT, so DP-3's x is negative — and it is -1600, DP-3's
// own width, which puts DP-3's right edge on HDMI-A-1's left edge at x=0. That
// is the rule to redo the arithmetic with if either panel is ever replaced: the
// left monitor's x is minus its own logical width, not minus the primary's.
//
// scale 1 throughout, unlike the laptop's 1.35. These are ordinary ~96 DPI desk
// monitors, and most of this image's GUI is Xwayland (fldigi is FLTK, chirp+wx is
// wxPython). Fractional scale on Xwayland gets you blurry upscaled bitmaps, so 1x
// is not a compromise here, it is correct.
output "HDMI-A-1" {
    scale 1
    position x=0 y=0
}

output "DP-3" {
    scale 1
    // Left of HDMI-A-1. y=0 top-aligns the two panels; they differ in height
    // (1080 vs 900), so the extra 180px falls off the bottom of DP-3.
    position x=-1600 y=0
}

// XWayland toolkit-scaling env vars (GDK_SCALE / QT_SCALE_FACTOR / Xft.dpi) are
// deliberately NOT set. At 1x there is nothing to correct, and setting them
// globally would scale native GTK apps twice.

environment {
    // Force Electron/Chromium and Qt onto native Wayland where they honor it.
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
    // XWayland via niri's xwayland-satellite integration.
    DISPLAY ":0"
}

prefer-no-csd

// Screenshots land here.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

layout {
    gaps 8
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#505050"
    }
}

// Startup: bar, notifications, polkit agent, clipboard history, XWayland, and the
// network/bluetooth tray applets. waybar's tray module stays empty without an SNI
// provider running; `nm-applet --indicator` uses the StatusNotifierItem path that
// waybar understands (plain `nm-applet` would try the dead XEmbed tray instead).
// Wallpaper. swaybg comes from the sway-atomic base, so nothing is layered for
// this, and it covers EVERY output by default — which is what is wanted here,
// since the two panels differ in aspect (1920x1080 and 1600x900). `-m fill`
// crops to fit rather than stretching, so neither is distorted.
//
// Run through `sh -c` because niri spawns via execvp with no shell, so $HOME
// would not expand otherwise.
//
// The IMAGE is not baked into the OS image, deliberately: a wallpaper is a
// personal preference that changes often, and baking it would mean a 13 GB
// rebuild to change a picture. The path points into $HOME, so dotfiles (or just
// dropping a different file at that path) override it with no rebuild. If the
// file is absent, swaybg exits and the desktop is simply plain — harmless.
//
// NOTE the file is a LOCAL copy, not the Nextcloud original. Pointing this at a
// network mount would mean no wallpaper whenever the mount is late or down, and
// niri starts long before any user mount is ready.
spawn-at-startup "sh" "-c" "swaybg -i \"$HOME/Pictures/wallpapers/digital-security-lock-uhd-4k-wallpaperdark.jpg\" -m fill"

spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"

// ---------------------------------------------------------------------------
// WINDOW RULES — the reason this image's niri config is not just the laptop's.
//
// Ham software is overwhelmingly floating-window software written against
// toolkits that predate tiling: WSJT-X is Qt with a fixed-ish waterfall geometry,
// fldigi is FLTK/X11, chirp+wx is wxPython. Tiled into columns they are not
// merely ugly — WSJT-X's waterfall and fldigi's decode panes get squeezed to
// unreadable heights, and several of these apps open child dialogs (rig settings,
// band selectors) that a tiling layout shoves into a column of their own.
//
// So the operating principle for this machine: ham apps float, everything else
// tiles. That is the whole difference.
//
// !! THE app-id VALUES BELOW ARE BEST-EFFORT AND NEED VERIFYING ON THE MACHINE.
// niri matches Wayland app-id, and for Xwayland clients it matches WM_CLASS.
// Neither can be read off a package. On first boot, open each app and run:
//
//     niri msg windows          # prints app-id + title for every open window
//
// then correct any rule that did not fire. A rule that matches nothing is silent
// — that is exactly how this file rots, so check it once rather than assuming.
// Patterns are regex, anchored, and case-sensitive; the (?i) prefix makes one
// case-insensitive where the toolkit's capitalisation is genuinely in doubt.

// The weak-signal digital cluster. Sized rather than merely floated: WSJT-X in
// particular is unusable below roughly this height because the waterfall and the
// decode list share the vertical space.
window-rule {
    match app-id=r#"^(?i)wsjt-?x$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 900; }
}

window-rule {
    match app-id=r#"^(?i)js8call$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 900; }
}

// The fldigi suite. FLTK under Xwayland; flrig is a small always-visible control
// panel and gets no fixed size, since its natural one is already right.
window-rule {
    match app-id=r#"^(?i)fldigi$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id=r#"^(?i)(flrig|flmsg|flamp)$"#
    open-floating true
}

// SDR receivers. These want to be wide — the whole point is a spectrum display —
// so they are floated but left at whatever size they ask for, which for gqrx and
// SDR++ is a remembered geometry that is usually already what you want.
window-rule {
    match app-id=r#"^(?i)(gqrx|sdrpp|sdrangel|qsstv)$"#
    open-floating true
}

// sdrtrunk is Java/Swing. Its WM_CLASS is set by StartupWMClass in the .desktop
// file that files/scripts/install-sdrtrunk.sh writes; if this rule does not fire,
// that is the first place to look, not this one.
window-rule {
    match app-id=r#"^(?i).*sdrtrunk.*$"#
    open-floating true
}

// Programming, logging, satellites. chirp+wx is the wxPython GUI — its WM_CLASS
// has been seen as both "Chirp" and "chirp" across releases, hence the (?i).
// QLog: always on DP-3 (the secondary head), always filling it. The app's layout
// — log table, band map, DX cluster, detail pane — is unusable in a half-width
// column, so it gets the whole output rather than a share of one. open-on-output
// is silently ignored if DP-3 is absent, so this stays harmless on the laptop.
// Use open-maximized instead of open-fullscreen if you want waybar kept visible.
window-rule {
    match app-id=r#"^QLog$"#
    open-on-output "DP-3"
    open-fullscreen true
}

// qlog was REMOVED from this list on 2026-08-26. It is a modern Qt app with a
// properly resizable layout and tiles fine; floating it just made it behave
// unlike every other window. The apps left here genuinely need floating — the
// rule is about toolkits that break when tiled, not about being ham software.
window-rule {
    match app-id=r#"^(?i)(chirp|klog|tqsl|gpredict|xastir)$"#
    open-floating true
}

// Wine. Every RT Systems programmer arrives as an Xwayland window whose app-id is
// derived from the .exe name, so there is no single id to match.
//
// VERIFIED 2026-08-26 with the DRCS25 installer open: niri reported its app-id as
// "drcs25_setup.exe". An earlier version of this rule matched r#"^(?i)wine$"# on
// the belief that niri matches the second WM_CLASS field (the literal "Wine"). It
// does not — it reports the INSTANCE name, which is the executable. That rule
// matched nothing, silently, exactly as kb3lyb-check-window-rules warns.
//
// So match the .exe suffix instead, which catches every Wine window whatever the
// programmer is called. "wine" is kept as an alternative for windows that do
// report the bare class. Floating is non-negotiable: Win32 apps assume a fixed
// window they position dialogs relative to.
window-rule {
    match app-id=r#"^(?i)(wine|.*\.exe)$"#
    open-floating true
}

// Transient dialogs from anything above — rig config, band settings, file
// pickers. Matched on title because the app-id is the parent app's.
window-rule {
    match title=r#"^(Settings|Preferences|Configure|Rig|Audio|About)"#
    open-floating true
}

cursor {
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminal, launcher, lock. Terminal is foot for now; ghostty (the intended
    // terminal, DESIGN §2) gets layered in once a COPR is vetted.
    Mod+Return  { spawn "foot"; }
    Mod+D       { spawn "fuzzel"; }
    Mod+Escape  { spawn "gtklock"; }

    // Clipboard history picker.
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    Mod+Q       { close-window; }

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }
    Mod+K       { focus-window-up; }
    Mod+J       { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    Mod+R       { switch-preset-column-width; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Escape hatch for X11 apps that fullscreen themselves. SDL/Ren'Py games set
    // _NET_WM_STATE_FULLSCREEN on their own window and re-assert it, so the
    // fullscreen-window bind above flips niri's flag and the client stomps it back.
    // wmctrl clears the property on the X side instead. DISPLAY :0 comes from the
    // environment block above, so this reaches xwayland-satellite's server.
    Mod+Shift+X { spawn "wmctrl" "-r" ":ACTIVE:" "-b" "remove,fullscreen"; }

    // Screenshots.
    Print       { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // Hardware keys. Volume/media only — a desktop has no backlight, and
    // brightnessctl is not installed, so the XF86MonBrightness* binds the laptop
    // config carries are omitted rather than left pointing at a missing binary.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
